<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>ByteShelf.Server</AssemblyName>
    <Version>3.0.0</Version>
    <!-- The GitHub release's notes (release.yml), above the list of pull requests it generates. -->
    <PackageReleaseNotes>
**Upgrading**

- Upgrade replicas together with their primary, primary first. A replica of this version stops at an older primary's log, and an older replica stops at this primary's (migrations v0015 and v0016, and a new change action).
- Clients, the CLI and MCP of this version need a server of this version: shelf info now carries the caller's permission and whether the server is a replica.
- `/mcp` shows agents previews of images only with the images plugin installed: `updaemon install byteshelf/images`. Plugins need updaemon 1.1 or later.
- Shelf usage and quotas now include the thumbnails and previews made of a shelf's files. An upload that would go over the quota through them is refused with 507.

**New**

- Plugins, loaded from `BYTESHELF_PLUGINS` with full trust, in the server and in the web UI. Released with the server: `byteshelf-images.zip` (thumbnails and previews, HEIC and TIFF shown, sized previews for agents) and `byteshelf-markdown.zip`. `--check-plugin` checks one; `GET /api/plugins` lists them.
- A preview of files over the shelf page, with images sharpening in place, PDFs, text, audio and video.
- Plugins can keep documents and searchable fields about files (`GET files/metadata`, `PUT files/plugin-metadata`, `--forget-plugin`), and give folders a type by the end of their name (`Trip.album`) that opens in their own viewer.
- Rows deleted from the database are overwritten (`secure_delete`), and what tells of a file's plain contents leaves the change log a day after it is encrypted in place. Rows deleted before the upgrade stay until `VACUUM` with the server stopped (DEPLOYMENT.md, Deleted data).

**Changed**

- Replacing a file that has a password of its own in the web UI keeps it encrypted.
- File contents are sent with `Cache-Control: private, no-cache`; thumbnails and previews with `private, max-age=3600`.
- Addresses of folders whose name has a dot, such as `v1.2`, load the app instead of 404.
- The page reloads when its session ends.
    </PackageReleaseNotes>
    <SpaRoot>..\byteshelf.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:44903</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ByteShelf.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Properties\launchSettings_git.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="updaemon.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-core" Version="6.0.15" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="EasyReasy.Auth" Version="5.15.0" />
    <PackageReference Include="EasyReasy.Database" Version="2.0.0" />
    <PackageReference Include="EasyReasy.Database.Mapping" Version="1.3.0" />
    <PackageReference Include="EasyReasy.Database.Sqlite" Version="1.0.1" />
    <PackageReference Include="EasyReasy.EnvironmentVariables" Version="1.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.14" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      Read what a file's contents say about it (Metadata/MetadataReader.cs), fully managed and offline:
      MetadataExtractor (Apache-2.0, with XmpCore, BSD) for EXIF and QuickTime/MP4, PdfPig (Apache-2.0)
      for a PDF's title and pages. Only the server reads metadata, so neither ships in ByteShelfClient.
    -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
    <ProjectReference Include="..\ByteShelf.Plugins\ByteShelf.Plugins.csproj" />
    <ProjectReference Include="..\ByteShelf.Tools\ByteShelf.Tools.csproj" />
    <ProjectReference Include="..\byteshelf.client\byteshelf.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
    <EmbeddedResource Include="Mcp\llms.txt" LogicalName="llms.txt" />
  </ItemGroup>

  <!--
    The names of the framework's assemblies, which a plugin always gets from the server
    (Plugins/Services/HostAssemblies.cs). Written at build, since at run time a self-contained publish
    has them in one folder with the server's own packages.
  -->
  <Target Name="EmbedFrameworkAssemblyNames" DependsOnTargets="ResolveTargetingPackAssets" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <FrameworkAssemblyNamesFile>$(IntermediateOutputPath)framework-assemblies.txt</FrameworkAssemblyNamesFile>
    </PropertyGroup>
    <ItemGroup>
      <FrameworkAssemblyName Include="@(Reference->'%(Filename)')" Condition="'%(Reference.FrameworkReferenceName)' != ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(FrameworkAssemblyNamesFile)" Lines="@(FrameworkAssemblyName)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(FrameworkAssemblyNamesFile)" LogicalName="framework-assemblies.txt" />
      <FileWrites Include="$(FrameworkAssemblyNamesFile)" />
    </ItemGroup>
  </Target>

</Project>
