<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>ByteShelf.Server</AssemblyName>
    <Version>2.1.0</Version>
    <!-- The GitHub release's notes (release.yml), above the list of pull requests it generates. -->
    <PackageReleaseNotes>
**Upgrading**

- Upgrade replicas before their primary. A replica stops following a newer primary, and says to update, until it is upgraded too.
- Share and upload links made before 2.1.0 stop working: a link's token now names a row that can be revoked. Make new ones.
- The first start migrates the database (v0011 to v0013), then reads the time taken, position and the like of the photos, videos and PDFs already stored, in the background.

**New**

- Find duplicate files: a Duplicates only switch in the web UI's search options, `find_duplicates` over MCP, `byteshelf find-duplicates` and the API.
- Revoke share and upload links: a Links tab in each shelf's settings, `list_links` and `revoke_link` over MCP, `byteshelf link list` and `link revoke`.
- What photos, videos and PDFs say about themselves (time taken, GPS position, camera, length, title, pages) is shown with a file's details and can be searched.
- Move and describe many entries in one request, over the API, MCP and the CLI.
- Sign in with a passkey alone, added in settings. Passkeys need `APP_BASE_URL` over HTTPS.
- Find the files with no description: a No description switch in the web UI's search options, and the same criterion over MCP, the CLI and the API. The web UI's search results page on with Show more.
    </PackageReleaseNotes>
    <SpaRoot>..\byteshelf.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:44903</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ByteShelf.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Properties\launchSettings_git.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="updaemon.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-core" Version="6.0.15" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="EasyReasy.Auth" Version="5.15.0" />
    <PackageReference Include="EasyReasy.Database" Version="2.0.0" />
    <PackageReference Include="EasyReasy.Database.Mapping" Version="1.3.0" />
    <PackageReference Include="EasyReasy.Database.Sqlite" Version="1.0.1" />
    <PackageReference Include="EasyReasy.EnvironmentVariables" Version="1.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.14" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      Scales a large image down to a preview /mcp's download_file can answer (Mcp/SkiaImagePreviews.cs;
      MIT). SkiaSharp carries the Windows and macOS native libraries itself; Linux's come from
      NoDependencies, which needs no fontconfig on the host since a preview draws no text. The
      platforms kept are in Directory.Build.targets. Not ImageSharp, though fully managed: its package
      checks at build time for a license key registered with Six Labors and fails a Release build
      without one, a key every builder of ByteShelf, and updaemon's, would then need.
    -->
    <PackageReference Include="SkiaSharp" Version="4.153.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.2" />
    <!--
      Read what a file's contents say about it (Metadata/MetadataReader.cs), fully managed and offline:
      MetadataExtractor (Apache-2.0, with XmpCore, BSD) for EXIF and QuickTime/MP4, PdfPig (Apache-2.0)
      for a PDF's title and pages. Only the server reads metadata, so neither ships in ByteShelfClient.
    -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
    <ProjectReference Include="..\ByteShelf.Tools\ByteShelf.Tools.csproj" />
    <ProjectReference Include="..\byteshelf.client\byteshelf.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
    <EmbeddedResource Include="Mcp\llms.txt" LogicalName="llms.txt" />
  </ItemGroup>

</Project>
