<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>ByteShelf.Server</AssemblyName>
    <Version>2.0.0</Version>
    <SpaRoot>..\byteshelf.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:44903</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ByteShelf.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Properties\launchSettings_git.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="updaemon.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-core" Version="6.0.15" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="EasyReasy.Auth" Version="5.13.0" />
    <PackageReference Include="EasyReasy.Database" Version="2.0.0" />
    <PackageReference Include="EasyReasy.Database.Mapping" Version="1.3.0" />
    <PackageReference Include="EasyReasy.Database.Sqlite" Version="1.0.1" />
    <PackageReference Include="EasyReasy.EnvironmentVariables" Version="1.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.14" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      Scales a large image down to a preview /mcp's download_file can answer (Mcp/SkiaImagePreviews.cs;
      MIT). SkiaSharp carries the Windows and macOS native libraries itself; Linux's come from
      NoDependencies, which needs no fontconfig on the host since a preview draws no text. The
      platforms kept are in Directory.Build.targets. Not ImageSharp, though fully managed: its package
      checks at build time for a license key registered with Six Labors and fails a Release build
      without one, a key every builder of ByteShelf, and updaemon's, would then need.
    -->
    <PackageReference Include="SkiaSharp" Version="4.153.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
    <ProjectReference Include="..\ByteShelf.Tools\ByteShelf.Tools.csproj" />
    <ProjectReference Include="..\byteshelf.client\byteshelf.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
    <EmbeddedResource Include="Mcp\llms.txt" LogicalName="llms.txt" />
  </ItemGroup>

</Project>
