<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a plugin's server assembly is written against (ByteShelf.Server/Plugins/Plugins.md). The server
    loads its own copy for every plugin, so a plugin references this without copying it to its output.
    Its assembly version stays 1.0.0.0: what a plugin needs of the server is the api in its plugin.json.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
