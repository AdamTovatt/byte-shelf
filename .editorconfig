root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# Block-scoped namespaces (per CLAUDE.md)
csharp_style_namespace_declarations = block_scoped:warning

# Never use var (per CLAUDE.md)
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# ── Suppressed analyzer rules ──────────────────────────────────────────────────
# CA2007: ConfigureAwait — irrelevant for ASP.NET Core (no SynchronizationContext)
dotnet_diagnostic.CA2007.severity = none
# CA1515: Make public types internal — public types are intentional (DI, test access)
dotnet_diagnostic.CA1515.severity = none
# CA1848: Use LoggerMessage delegates — too noisy for moderate-traffic app
dotnet_diagnostic.CA1848.severity = none
# CA1062: Validate arguments of public methods — ASP.NET model binding / DI validates
dotnet_diagnostic.CA1062.severity = none
# CA1873: Avoid expensive logging argument evaluation — too noisy
dotnet_diagnostic.CA1873.severity = none
# CA1031: Do not catch general exception types — common in top-level handlers
dotnet_diagnostic.CA1031.severity = none
# CA2016: Forward CancellationToken — pervasive refactor, low practical risk
dotnet_diagnostic.CA2016.severity = none
# CA1002: Do not expose generic lists — changing return types would be breaking
dotnet_diagnostic.CA1002.severity = none
# CA2227: Collection properties should be read only — conflicts with DTOs/models
dotnet_diagnostic.CA2227.severity = none
# CA1716: Identifiers should not match keywords — false positives on common names
dotnet_diagnostic.CA1716.severity = none
# CA1034: Nested types should not be visible — intentional in several places
dotnet_diagnostic.CA1034.severity = none
# CA1819: Properties should not return arrays — too restrictive for DTOs
dotnet_diagnostic.CA1819.severity = none
# CA1032: Implement standard exception constructors — we only need the overloads we use
dotnet_diagnostic.CA1032.severity = none
# CA1822: Mark members as static — method may need instance access later
dotnet_diagnostic.CA1822.severity = none
# CA1724: Type names should not match namespaces — false positives
dotnet_diagnostic.CA1724.severity = none
# CA1720: Identifiers should not contain type names — too noisy
dotnet_diagnostic.CA1720.severity = none
# CA1711: Identifiers should not have incorrect suffix — too restrictive
dotnet_diagnostic.CA1711.severity = none
# CA1068: CancellationToken parameters must come last — conflicts with optional params
dotnet_diagnostic.CA1068.severity = none
# CA1305: Specify IFormatProvider — pervasive refactor
dotnet_diagnostic.CA1305.severity = none
# CA1307: Specify StringComparison for clarity — pervasive refactor
dotnet_diagnostic.CA1307.severity = none
# CA1308: Normalize strings to uppercase — stylistic, ToLower is fine
dotnet_diagnostic.CA1308.severity = none
# CA1310: Specify StringComparison for correctness — pervasive refactor
dotnet_diagnostic.CA1310.severity = none
# CA1056: URI properties should not be strings — would require major refactor
dotnet_diagnostic.CA1056.severity = none
# CA1054: URI parameters should not be strings — would require major refactor
dotnet_diagnostic.CA1054.severity = none
# CA2234: Pass System.Uri instead of string — would require major refactor
dotnet_diagnostic.CA2234.severity = none
# CA1849: Use async overloads — many call sites require structural refactoring
dotnet_diagnostic.CA1849.severity = none
# CA1859: Use concrete types — interface return types are intentional for abstraction
dotnet_diagnostic.CA1859.severity = none
# CA2100: Review SQL queries for injection — house SQL is interpolated only with nameof() column aliases; all values go through parameterized queries via EasyReasy.Database
dotnet_diagnostic.CA2100.severity = none
# CA1024: Use properties where appropriate — methods are intentional
dotnet_diagnostic.CA1024.severity = none
# CA2000: Dispose objects before losing scope — false positives with DI ownership transfer
dotnet_diagnostic.CA2000.severity = none
# CA2025: Ensure tasks complete before dispose — false positives with await patterns
dotnet_diagnostic.CA2025.severity = none
# CA1052: Static holder types — Program class must stay non-static for WebApplicationFactory
dotnet_diagnostic.CA1052.severity = none
# CA1051: Do not declare visible instance fields — protected fields in abstract base classes
dotnet_diagnostic.CA1051.severity = none
# CA1304: Specify CultureInfo — same family as CA1305
dotnet_diagnostic.CA1304.severity = none
# CA1309: Use ordinal StringComparison — same family as CA1307
dotnet_diagnostic.CA1309.severity = none
# CA1311: Specify a culture or use invariant — same family as CA1305
dotnet_diagnostic.CA1311.severity = none

# ── Test project relaxations ───────────────────────────────────────────────────
# Test code has different conventions: underscore naming, disposable fixtures,
# inline arrays, unsealed classes, non-cryptographic random, etc.
[{*Tests*/**/*.cs,*Tests*/*.cs}]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1812.severity = none
