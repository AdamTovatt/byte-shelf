<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 and AOT-compatible on purpose: some consumers publish native AOT on net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ByteShelfClient</PackageId>
    <Title>ByteShelf.Client</Title>
    <Authors>Adam Tovatt</Authors>
    <PackageIcon>ByteShelfIcon256.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/AdamTovatt/byte-shelf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamTovatt/byte-shelf</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>storage, api, client, byteshelf, byte shelf, file storage</PackageTags>
    <Description>Client for ByteShelf, a self-hosted file store: an interface over shelves, files and directories, an HTTP implementation, and an in-memory one for tests.</Description>
    <Copyright>MIT</Copyright>
    <Version>2.2.0</Version>
    <PackageReleaseNotes>Adds OpenReadRangeAsync to IShelfClient, in the HTTP client and the in-memory one: it reads part of a file, from an offset for a length or to the end, as a ShelfFileRange carrying the range's offset and length, the file's total length and the SHA-256 of the contents it came from, to seek in a video or answer a browser's Range request. A range starting at or past the end is refused with range_not_satisfiable; given the SHA-256 read earlier, a file whose contents have changed is refused with content_changed. Only a range that is the whole file is checked against its SHA-256. Works with ByteShelf server 2.0.0 and later. IShelfClient gains a member, so an implementation outside ByteShelfClient must add it. See https://github.com/AdamTovatt/byte-shelf/blob/client-v$(Version)/ByteShelfClient/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\ByteShelfIcon256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the age tests, which check scrypt and header parsing on their own. -->
    <InternalsVisibleTo Include="ByteShelfClient.Tests" />
  </ItemGroup>

</Project>
