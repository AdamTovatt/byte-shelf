<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 and AOT-compatible on purpose: some consumers publish native AOT on net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ByteShelfClient</PackageId>
    <Title>ByteShelf.Client</Title>
    <Authors>Adam Tovatt</Authors>
    <PackageIcon>ByteShelfIcon256.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/AdamTovatt/byte-shelf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamTovatt/byte-shelf</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>storage, api, client, byteshelf, byte shelf, file storage</PackageTags>
    <Description>Client for ByteShelf, a self-hosted file store: an interface over shelves, files and directories, an HTTP implementation, and an in-memory one for tests.</Description>
    <Copyright>MIT</Copyright>
    <Version>3.1.0</Version>
    <PackageReleaseNotes>Adds IByteShelfClient.GetServerVersionAsync, the release the server runs and its deploy id, for any signed-in user or shelf key. The HTTP client asks the server, which needs ByteShelf server 2.3.0; the in-memory client, having no server, answers this package's own version. IByteShelfClient gains a member, so an implementation outside ByteShelfClient must follow. IShelfClient.SetGrantAsync now throws ArgumentException for a permission that is none of the ShelfAccessPermission values, before anything is sent, in the HTTP client and the in-memory one alike (ByteShelfCommon's ShelfGrants.ValidatePermission); the HTTP client failed with a JsonException and the in-memory one with a ByteShelfException. See https://github.com/AdamTovatt/byte-shelf/blob/client-v$(Version)/ByteShelfClient/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\ByteShelfIcon256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the age tests, which check scrypt and header parsing on their own. -->
    <InternalsVisibleTo Include="ByteShelfClient.Tests" />
  </ItemGroup>

</Project>
