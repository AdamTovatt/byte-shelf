<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 and AOT-compatible on purpose: some consumers publish native AOT on net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ByteShelfClient</PackageId>
    <Title>ByteShelf.Client</Title>
    <Authors>Adam Tovatt</Authors>
    <PackageIcon>ByteShelfIcon256.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/AdamTovatt/byte-shelf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamTovatt/byte-shelf</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>storage, api, client, byteshelf, byte shelf, file storage</PackageTags>
    <Description>Client for ByteShelf, a self-hosted file store: an interface over shelves, files and directories, an HTTP implementation, and an in-memory one for tests.</Description>
    <Copyright>MIT</Copyright>
    <Version>3.0.0</Version>
    <PackageReleaseNotes>Breaking: a shelf key may work on several shelves, as ByteShelfCommon 3.0.0's ShelfKeyInfo.Grants lists. IShelfClient.DeleteKeyAsync is replaced by RemoveKeyGrantAsync, which takes the shelf from a key and deletes the key only when that was its last shelf; IShelfClient.SetKeyGrantAsync gives an existing key the shelf or changes its access there; IByteShelfClient.GetKeyGrantsAsync lists a key's shelves and IByteShelfClient.DeleteKeyAsync deletes a key from every shelf. All of these in the HTTP client and the in-memory one. CreateKeyAsync and SetKeyGrantAsync throw ArgumentException for a permission that is none of the values, before anything is sent. Needs a ByteShelf server whose keys hold grants (its migration v0014). IShelfClient and IByteShelfClient change members, so an implementation outside ByteShelfClient must follow. See https://github.com/AdamTovatt/byte-shelf/blob/client-v$(Version)/ByteShelfClient/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\ByteShelfIcon256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelfCommon\ByteShelfCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the age tests, which check scrypt and header parsing on their own. -->
    <InternalsVisibleTo Include="ByteShelfClient.Tests" />
  </ItemGroup>

</Project>
