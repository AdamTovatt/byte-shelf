<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TestProgram: a child process of the server the tests run runs makers of theirs. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteShelf.Server\ByteShelf.Server.csproj" />
    <ProjectReference Include="..\ByteShelfClient\ByteShelfClient.csproj" />
    <ProjectReference Include="..\ByteShelf.Cli\ByteShelf.Cli.csproj" />
    <!-- Built before the tests and never referenced by them: the server loads it as it does any plugin. -->
    <ProjectReference Include="..\ByteShelf.Server.Tests.Plugin\ByteShelf.Server.Tests.Plugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\images\server\ByteShelf.Plugins.Images.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Beside the tests, where TestPlugins takes it from. -->
  <Target Name="CopyTestPlugin" AfterTargets="Build">
    <ItemGroup>
      <TestPluginFile Include="..\ByteShelf.Server.Tests.Plugin\bin\$(Configuration)\$(TargetFramework)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestPluginFile)" DestinationFolder="$(OutDir)test-plugin" SkipUnchangedFiles="true" />
  </Target>

  <!-- A folder of plugins beside the tests, with the images plugin's server part as it is built in it, and the version its release gives it. -->
  <Target Name="CopyImagesPlugin" AfterTargets="Build">
    <ItemGroup>
      <ImagesPluginFile Include="..\plugins\images\server\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ImagesPluginFile)" DestinationFiles="@(ImagesPluginFile->'$(OutDir)images-plugin\images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(OutDir)images-plugin\images\plugin.json" Lines="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\plugins\images\plugin.json').Replace('&quot;api&quot;', '&quot;version&quot;: &quot;1.0.0&quot;, &quot;api&quot;'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
