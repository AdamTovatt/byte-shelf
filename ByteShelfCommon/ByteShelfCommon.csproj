<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 and AOT-compatible on purpose: some consumers publish native AOT on net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ByteShelfCommon</PackageId>
    <Title>ByteShelf.Common</Title>
    <Authors>Adam Tovatt</Authors>
    <PackageIcon>ByteShelfIcon256.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/AdamTovatt/byte-shelf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamTovatt/byte-shelf</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Shared contract of ByteShelf, a self-hosted file store: the request and response types the server and ByteShelfClient exchange, path rules, and source-generated JSON.</Description>
    <Copyright>MIT</Copyright>
    <Version>3.1.0</Version>
    <!-- Major and minor alone: a server loads a plugin built against an earlier or the same one (ByteShelf.Server/Plugins/Plugins.md), and a patch adds nothing it could miss. -->
    <AssemblyVersion>$([System.Version]::Parse('$(Version)').ToString(2)).0.0</AssemblyVersion>
    <PackageReleaseNotes>Adds ServerVersion, the release a ByteShelf server runs with its deploy id, as its api/version/release answers it to a signed-in user or a shelf key, and ReleaseVersion, which reads an assembly's release from its informational version without the commit after the +. ShelfGrants.ValidatePermission refuses a value that is no ShelfAccessPermission with ArgumentException naming the parameter, as ShelfKeys.ValidatePermission does for a key's. See https://github.com/AdamTovatt/byte-shelf/blob/client-v$(Version)/ByteShelfCommon/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\ByteShelfIcon256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
