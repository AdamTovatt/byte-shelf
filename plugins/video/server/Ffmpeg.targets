<Project>
  <!--
    The static ffmpeg and ffprobe the plugin runs, from a dated build of BtbN/FFmpeg-Builds (GPL, with libx264), pinned
    by its release, its asset and the asset's SHA-256, downloaded as the plugin builds and kept under obj, never in the
    repository. A build takes the one of the machine it is on; a publish, which is what the plugin's zip is made of,
    takes every one, so the zip is for all of them. Each comes into ffmpeg/<runtime>/ with ffmpeg's licence and what
    build it is, with each library it is built with and where its source is (BUILD.txt, of FfmpegLibraries.txt).
    README.md says how to move to a newer one.
  -->
  <PropertyGroup>
    <FfmpegRelease>autobuild-2026-10-31-12-59</FfmpegRelease>
    <FfmpegReleaseUrl>https://github.com/BtbN/FFmpeg-Builds/releases/download/$(FfmpegRelease)</FfmpegReleaseUrl>
    <FfmpegCache>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)ffmpeg/$(FfmpegRelease)/</FfmpegCache>
    <FfmpegHostRuntime Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</FfmpegHostRuntime>
    <FfmpegHostRuntime Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</FfmpegHostRuntime>
  </PropertyGroup>

  <ItemGroup>
    <FfmpegBuild Include="linux-x64" Runtime="linux-x64" Asset="ffmpeg-n9.0.2-39-g7adfbe40dc-linux64-gpl-9.0" Sha256="73e29a56974ae5a651133a04584c7483b21afe941e17dc91d79814a758b608d3" />
    <FfmpegBuild Include="linux-arm64" Runtime="linux-arm64" Asset="ffmpeg-n9.0.2-39-g7adfbe40dc-linuxarm64-gpl-9.0" Sha256="6cad88ae5bcec356cfc5d7979a036cc4007128201928a0cf243df3db483276cc" />
  </ItemGroup>

  <Target Name="_ChooseFfmpeg">
    <ItemGroup>
      <_FfmpegWanted Include="@(FfmpegBuild)" Condition="'$(_IsPublishing)' == 'true' Or '%(Runtime)' == '$(FfmpegHostRuntime)'" Folder="$(FfmpegCache)%(Runtime)/" />
    </ItemGroup>
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)FfmpegLibraries.txt">
      <Output TaskParameter="Lines" ItemName="_FfmpegLibrary" />
    </ReadLinesFromFile>
  </Target>

  <!-- Once for each build wanted, and again only when this file changes. -->
  <Target Name="_FetchFfmpeg" DependsOnTargets="_ChooseFfmpeg" Inputs="$(MSBuildThisFileFullPath)" Outputs="%(_FfmpegWanted.Folder).fetched">
    <PropertyGroup>
      <_FfmpegUrl>$(FfmpegReleaseUrl)/%(_FfmpegWanted.Asset).tar.xz</_FfmpegUrl>
      <_FfmpegArchive>$(FfmpegCache)%(_FfmpegWanted.Asset).tar.xz</_FfmpegArchive>
      <_FfmpegFolder>%(_FfmpegWanted.Folder)</_FfmpegFolder>
    </PropertyGroup>

    <DownloadFile SourceUrl="$(_FfmpegUrl)" DestinationFolder="$(FfmpegCache)" Retries="2" ContinueOnError="true" />
    <Error Condition="'$(MSBuildLastTaskResult)' != 'true'" Text="ffmpeg %(_FfmpegWanted.Asset) of $(FfmpegRelease) could not be downloaded from $(_FfmpegUrl). If the release is gone, pin a newer one in plugins/video/server/Ffmpeg.targets, as plugins/video/README.md says." />

    <GetFileHash Files="$(_FfmpegArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FfmpegHash" />
    </GetFileHash>
    <Delete Condition="'$(_FfmpegHash.ToLowerInvariant())' != '%(_FfmpegWanted.Sha256)'" Files="$(_FfmpegArchive)" />
    <Error Condition="'$(_FfmpegHash.ToLowerInvariant())' != '%(_FfmpegWanted.Sha256)'" Text="ffmpeg %(_FfmpegWanted.Asset) of $(FfmpegRelease), from $(_FfmpegUrl), has the SHA-256 $(_FfmpegHash.ToLowerInvariant()), not the pinned %(_FfmpegWanted.Sha256). It was removed, and nothing of it is used." />

    <RemoveDir Directories="$(_FfmpegFolder)" />
    <MakeDir Directories="$(_FfmpegFolder)" />
    <Exec Command="tar -xJf &quot;$(_FfmpegArchive)&quot; -C &quot;$(_FfmpegFolder)&quot; --strip-components=2 &quot;%(_FfmpegWanted.Asset)/bin/ffmpeg&quot; &quot;%(_FfmpegWanted.Asset)/bin/ffprobe&quot;" />
    <Exec Command="tar -xJf &quot;$(_FfmpegArchive)&quot; -C &quot;$(_FfmpegFolder)&quot; --strip-components=1 &quot;%(_FfmpegWanted.Asset)/LICENSE.txt&quot;" />
    <Delete Files="$(_FfmpegArchive)" />
    <Touch Files="$(_FfmpegFolder).fetched" AlwaysCreate="true" />
  </Target>

  <!-- What build it is and what it is built with, again whenever this file or the list of its libraries changes. -->
  <Target
    Name="_DescribeFfmpeg"
    DependsOnTargets="_FetchFfmpeg"
    Inputs="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)FfmpegLibraries.txt"
    Outputs="%(_FfmpegWanted.Folder)BUILD.txt">
    <WriteLinesToFile
      File="%(_FfmpegWanted.Folder)BUILD.txt"
      Overwrite="true"
      Lines="ffmpeg and ffprobe of %(_FfmpegWanted.Asset), static, from the release $(FfmpegRelease) of https://github.com/BtbN/FFmpeg-Builds, which says how it was built;$(FfmpegReleaseUrl)/%(_FfmpegWanted.Asset).tar.xz;SHA-256 of that archive: %(_FfmpegWanted.Sha256);ffmpeg's source: https://git.ffmpeg.org/ffmpeg.git, at the revision its name ends with (after the g);;Built with these, each from its source at the revision named, by the scripts of https://github.com/BtbN/FFmpeg-Builds/tree/$(FfmpegRelease)/scripts.d:;@(_FfmpegLibrary)" />
  </Target>

  <Target Name="AddFfmpeg" BeforeTargets="AssignTargetPaths" DependsOnTargets="_DescribeFfmpeg">
    <ItemGroup>
      <_FfmpegFile Include="@(_FfmpegWanted->'%(Folder)ffmpeg');@(_FfmpegWanted->'%(Folder)ffprobe');@(_FfmpegWanted->'%(Folder)LICENSE.txt');@(_FfmpegWanted->'%(Folder)BUILD.txt')" />
      <None Include="@(_FfmpegFile)" Link="ffmpeg/%(_FfmpegFile.Runtime)/%(_FfmpegFile.Filename)%(_FfmpegFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
